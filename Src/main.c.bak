/* USER CODE BEGIN 4 */

uint8_t crc8_cal(const uint8_t *data, size_t length) {
    uint8_t crc = 0x00;
    for (size_t i = 0; i < length; ++i) {
        crc = CRC8_TABLE[crc ^ data[i]];
    }
    return crc;
}

uint16_t crc_cal(uint8_t* data, int num)
{
	uint16_t i,j;
	uint16_t crc;
	crc = 0xffff;
	for (j=0; j < num; j++)
	{
		crc = (uint16_t)(crc ^ data[j]);
		for (i=0; i<=7; i++)
		{
			if ((crc & 0x0001) == 1)
			{
				crc = crc >> 1;
				crc = crc ^ 0xa001;
			}
			else
				crc = (uint16_t)(crc >> 1);
		}
	}
	crc = (uint16_t)(((crc << 8)|(crc >> 8)) & 0xffff);
	return crc;
}
uint8_t enable_tx = 0, rs485_state = 0, cmd;
uint8_t High_Address, Low_Address;
uint8_t High_Number, Low_Number;
uint8_t CRC_H, CRC_L;
uint16_t inter_check, DATA_CRC, MyCRC;
char valid_data[6];
uint8_t input_data[6];
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
  /* Prevent unused argument(s) compilation warning */
  /* NOTE : This function should not be modified, when the callback is needed,
            the HAL_UART_RxCpltCallback can be implemented in the user file
   */
	char i;
	if (huart->Instance == USART3)  //current UART
	{
		inter_check++;
		switch(rs485_state)
		{
			case 0:
				if (rx485_buff[0] == HMI_ID)
				{
					rs485_state = 1;
					input_data[0] = HMI_ID;
				}
				else 
				{
					rs485_state = 0;
					enable_tx = 0;
				}
				break;
			case 1:
				cmd = rx485_buff[0];
				input_data[1] = cmd;
				rs485_state = 2;
				break;
			case 2:
				High_Address = rx485_buff[0];
				input_data[2] = High_Address;
				rs485_state = 3;
				break;
			case 3:
				Low_Address = rx485_buff[0];
				input_data[3] = Low_Address;
				rs485_state = 4;
				break;
			case 4:
				High_Number = rx485_buff[0];
				input_data[4] = High_Number;
				rs485_state = 5;
				break;
			case 5:
				Low_Number = rx485_buff[0];
				input_data[5] = Low_Number;
				rs485_state = 6;
				break;
			case 6:
				CRC_H = rx485_buff[0];
				rs485_state = 7;
				break;
			case 7:
				CRC_L = rx485_buff[0];
				DATA_CRC = CRC_H*256 + CRC_L;
				MyCRC = crc_cal(input_data,6);
				if(MyCRC == DATA_CRC)
				{ 
					for( i=0; i<=5; i++) {
						valid_data[i] = input_data[i];
					}
					enable_tx = 1;
					rs485_state = 0;
				}
				else
				{
					for( i=0; i<=5; i++) {
						valid_data[i] = 0;
					}
					rs485_state = 0;
				}
				break;
				
			default:
				enable_tx = 0;
				rs485_state = 0;
				break;
		}
		HAL_UART_Receive_IT(&huart3, rx485_buff, 1);
	}
}

void I2C_Transmit(void){ 
	I2C_Count++;
	if (I2C_Count>199) I2C_Count = 0;
	txData[0] = '{'; // Start frame
	txData[1] = (uint8_t)getDate.Date; // Ngay
	txData[2] = (uint8_t)getDate.Month; // Thang
	txData[3] = 20; // Nam 20
	txData[4] = (uint8_t)getDate.Year; // Nam 26
	txData[5] = (uint8_t)getTime.Hours; // Gio
	txData[6] = (uint8_t)getTime.Minutes; // Phut
	txData[7] = (uint8_t)getTime.Seconds; // Giay
	txData[8] = 101; // Xanh 1
	txData[9] = 3; // Vang 1
	txData[10] = 2; // Giai Toa 1
	txData[11] = 199; // Xanh 2
	txData[12] = 3; // Vang 2
	txData[13] = 2; // Giai Toa 2
	txData[14] = 10; // Xanh 3
	txData[15] = 10; // Vang 3
	txData[16] = 10; // Giai Toa 3
	txData[17] = 10; // Volt 1
	txData[18] = 10; // Volt 2
	txData[19] = 10; // Current 1
	txData[20] = I2C_Count; // Current 2
	txData[21] = '}'; // Stop frame
	
	HAL_I2C_Master_Transmit(&hi2c1, (ESP32_ADDR << 1), txData, 22, 100);
} 

void RTC_SetDateTime(void){ // SET RTC
    /* Set Time: 14:25:30 */
    setTime.Hours = 14;
    setTime.Minutes = 25;
    setTime.Seconds = 30;
    setTime.DayLightSaving = RTC_DAYLIGHTSAVING_NONE;
    setTime.StoreOperation = RTC_STOREOPERATION_RESET;
	HAL_RTC_SetTime(&hrtc, &setTime, RTC_FORMAT_BIN);

    /* Set Date: Monday, 15/04/2026 */
    setDate.WeekDay = RTC_WEEKDAY_MONDAY;
    setDate.Month   = RTC_MONTH_APRIL;
    setDate.Date    = 13;
    setDate.Year    = 26;   // chỉ lưu 2 số cuối: 2026 -> 26
	HAL_RTC_SetDate(&hrtc, &setDate, RTC_FORMAT_BIN);
	
	HAL_RTCEx_BKUPWrite(&hrtc, RTC_BKP_DR1, 0x12);
}

void RTC_GetDateTime(void){ // Read RTC
    HAL_RTC_GetTime(&hrtc, &getTime, RTC_FORMAT_BIN);
    HAL_RTC_GetDate(&hrtc, &getDate, RTC_FORMAT_BIN);
}


