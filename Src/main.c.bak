/**
  * @brief  Function implementing the MainTask thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_StartMainTask */
void StartMainTask(void const * argument)
{
  /* USER CODE BEGIN 5 */
	ETH_PWR_0;
	HAL_DAC_Start(&hdac, DAC_CHANNEL_1);
	HAL_DAC_Start(&hdac, DAC_CHANNEL_2);
  /* Infinite loop */
  for(;;)
  {
	  count++;
	  
    LED1_0;
	  LED2_1;
	  LED3_0;
	  LED4_1;
	  SL_0;
	  X1_1;
	V1_0;
	D1_1;
	Xdb1_0;
	Ddb1_1;
	X2_0;
	V2_1;
	D2_0;
	Xdb2_1;
	Ddb2_0;
	X3_1;
	V3_0;
	D3_1;
	Xdb3_0;
	Ddb3_1;
	
	  osDelay(2500);
	  
	  LED1_1;
	  LED2_0;
	  LED3_1;
	  LED4_0;
	  SL_1;
	  X1_0;
	V1_1;
    D1_0;
    Xdb1_1 ;
    Ddb1_0 ;
    X2_1;
    V2_0;
    D2_1;
    Xdb2_0 ;
    Ddb2_1 ;
    X3_0;
    V3_1;
    D3_0;
    Xdb3_1 ;
    Ddb3_0 ;

	I2C_Transmit();
	
	if (dac_voltage>9.9) dac_voltage = 9.9f;
	dac_value = (uint32_t)((dac_voltage/3.0f) * 4095.0f / Vref); // dac_voltage 0..10V
	HAL_DAC_SetValue(&hdac, DAC_CHANNEL_1, DAC_ALIGN_12B_R, dac_value);
	HAL_DAC_SetValue(&hdac, DAC_CHANNEL_2, DAC_ALIGN_12B_R, dac_value);


    osDelay(2500);
  }
  /* USER CODE END 5 */
}

/* USER CODE BEGIN Header_StartConnectivityTask */
/**
* @brief Function implementing the ConnectivityTas thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_StartConnectivityTask */
void StartConnectivityTask(void const * argument)
{
  /* USER CODE BEGIN StartConnectivityTask */
  /* Infinite loop */
  for(;;)
  {
	  	/////////////RESET WathDog timer///////////////////////////////////////
		//IWDG->KR = 0xAAAA; // Reload Counter prevents watchdog reset
		/////////////////////////////////////////////////////////////////////////////
	HAL_RTC_GetTime(&hrtc, &getTime, RTC_FORMAT_BIN);
	HAL_RTC_GetDate(&hrtc, &getDate, RTC_FORMAT_BIN);
	  
	  //////////////////////////////////////////////////// RS485 for HMI
	uint8_t clear = 0;
	if (enable_tx == 1)
	{
		if ((cmd == 1) || (cmd == 2))
		{
			uint8_t temp=0,temp1=0;
			start_address =valid_data[3];
			num_reg = valid_data[5];
			length_data_send = 5 + (num_reg - 1)/8 + 1;
			
			data_send[0] = HMI_ID;		//Device address	
			data_send[1] = cmd;	//Func write 1 word
			data_send[2] = (num_reg - 1)/8 + 1;
			
			for(temp=0;temp<num_reg;temp++)
			{
				data_send[3+temp]=0;
				if(num_reg<9)
				{
					for(temp1=0;temp1<num_reg;temp1++)
						{
							data_send[3+temp] |= (((regbank[cmd-1][valid_data[3]+temp*8+temp1]&0x01))<<temp1);
						}
				}
				else if(num_reg>9)
						{
					for(temp1=0;temp1<8;temp1++)
						{
							data_send[3+temp] |= (((regbank[cmd-1][valid_data[3]+temp*8+temp1]&0x01))<<temp1);
						}
						}
				temp1=0;
			}
			temp=0;
			my_crc = crc_cal((char*)data_send,length_data_send-2);
			data_send[length_data_send - 2] = ((my_crc >> 8) & 0xff);
			data_send[length_data_send - 1] = (my_crc & 0xff);
			HAL_GPIO_WritePin(RS485_DIR_GPIO_Port, RS485_DIR_Pin, 1);
			HAL_UART_Transmit(&huart3, &data_send[0],length_data_send,0xff);
			HAL_GPIO_WritePin(RS485_DIR_GPIO_Port, RS485_DIR_Pin, 0);
		}
	
		else if (cmd == 3)
		{
			start_address = (valid_data[2]<<8)|(valid_data[3]);
			num_reg = (valid_data[4]<<8)|(valid_data[5]);
			length_data_send = 5 + num_reg*2;
			
			data_send[0] = HMI_ID;		//Device address	
			data_send[1] = cmd;		//Func write 1 word
			data_send[2] = num_reg*2;
			
			for(uint8_t i = 0; i < (num_reg*2); i = i + 2)
			{
				data_send[3 + i] = (regbank[cmd - 1][start_address + i/2]>>8)&0xff;
				data_send[3 + i + 1] = (regbank[cmd - 1][start_address + i/2])&0xff;
			}
			
			my_crc = crc_cal((char*)data_send,length_data_send-2);
			data_send[length_data_send - 2] = ((my_crc >> 8) & 0xff);
			data_send[length_data_send - 1] = (my_crc & 0xff);
			RS485_DIR_1;
			HAL_UART_Transmit(&huart3, &data_send[0],length_data_send,0xff);
			RS485_DIR_0;
		}
		else if(cmd == 4)
		{
			start_address = (valid_data[2]<<8)|valid_data[3];
			num_reg = 5+(valid_data[4]<<8)|valid_data[5];
			length_data_send = 5 + num_reg*2;

			data_send[0] = HMI_ID;		//Device address	
			data_send[1] = cmd;		//Func write 1 word
			data_send[2] = num_reg*2;
			
			for(uint8_t i = 0; i < (num_reg*2); i = i + 2)
			{
				data_send[3 + i] = (regbank[cmd - 1][start_address + i/2]>>8)&0xff;
				data_send[4 + i + 1] = (regbank[cmd - 1][start_address + i/2])&0xff;
			}
			my_crc = crc_cal((char*)data_send,length_data_send-2);
			data_send[length_data_send - 2] = ((my_crc >> 8) & 0xff);
			data_send[length_data_send - 1] = (my_crc & 0xff);
			RS485_DIR_1;
			HAL_UART_Transmit(&huart3, &data_send[0],length_data_send,0xff);
			RS485_DIR_0;
		}	
		else if(cmd == 5)
		{
			data_send[0] = HMI_ID;
			data_send[1] = 05;
			data_send[2] = 0;
			data_send[3] = valid_data[3];
			data_send[4] = valid_data[4];
			data_send[5] = valid_data[5];
			reg_address =valid_data[3];
			value =valid_data[4];
			if(value == 0xFF)
			{
				regbank[0][valid_data[3]] = 1;
			}
			else
			{
				regbank[0][valid_data[3]] = 0;
			}
			my_crc = crc_cal((char*)data_send,6);
			data_send[6] = ((my_crc >> 8) & 0xff);
			data_send[7] = (my_crc & 0xff);
			RS485_DIR_1;
			HAL_UART_Transmit(&huart3, &data_send[0],7,0xff);
			RS485_DIR_0;
		}	
		else if(cmd == 6)
		{
			reg_address = valid_data[3];
			value = (valid_data[4]<<8)| valid_data[5];
			regbank[2][reg_address] = value;
			my_crc = crc_cal((char*)data_send,6);
			data_send[6] = ((my_crc >> 8) & 0xff);
			data_send[7] = (my_crc & 0xff);
			RS485_DIR_1;
			HAL_UART_Transmit(&huart3, &data_send[0],length_data_send,0xff);
			RS485_DIR_0;
		}  
	}
	for(clear = 0;clear<8;clear++)
	{
		data_send[clear]=0;
	}
	clear=0;
	enable_tx = 0;
	////////////////////////////////////////////////////
// reset thong bao nhap thoi gian ok
			input_ok++;
			if (input_ok >=800)  {regbank[0][11]=0; input_ok=0;}
			
			if (ResetRTC_count <= 15000) ResetRTC_count++;
			if (regbank[0][97] == 1) ResetRTC_count = 0;
			if (ResetRTC_count == 15000) {
				ResetRTC_count = 15001;
				// reset Set RTC to default
				regbank[2][58] = 0;
				regbank[2][59] = 0;
				regbank[2][70] = 0;
				regbank[2][71] = 0;
				regbank[2][72] = 0;
				regbank[2][73] = 0;
				regbank[2][74] = 0;
				regbank[0][97] = 0;
			}
			
// send Real time from RTC to HMI	
	regbank[2][52] = getTime.Hours;
	regbank[2][53] = getTime.Minutes;
	regbank[2][54] = getTime.Seconds;
	regbank[2][55] = getDate.Date;
	regbank[2][56] = getDate.Month;
	regbank[2][57] = getDate.Year;
	
// SET time to RTC
	if (regbank[0][96] == 1){
		setTime.Hours 	= regbank[2][58];
		setTime.Minutes 	= regbank[2][59];
		setTime.Seconds 	= regbank[2][70];
		setTime.DayLightSaving = RTC_DAYLIGHTSAVING_NONE;
		setTime.StoreOperation = RTC_STOREOPERATION_RESET;
		HAL_RTC_SetTime(&hrtc, &setTime, RTC_FORMAT_BIN);
		
		if (regbank[2][74]>1) setDate.WeekDay = regbank[2][74]-1;
		if (regbank[2][74]==1) setDate.WeekDay = RTC_WEEKDAY_SUNDAY;
		
		setDate.Month   	= regbank[2][72];
		setDate.Date    	= regbank[2][71];
		setDate.Year    	= regbank[2][73];   // chỉ lưu 2 số cuối: 2026 -> 26
		HAL_RTC_SetDate(&hrtc, &setDate, RTC_FORMAT_BIN);
		
		HAL_RTCEx_BKUPWrite(&hrtc, RTC_BKP_DR1, 0x12);
		// inform input_ok
		regbank[0][96] = 0;
		regbank[0][11] = 1;
		input_ok = 0;
		ResetRTC_count = 0;
	}

////// SET Data
	if (regbank[0][94] == 1){
		X1 =	regbank[2][120]*10000;	// xanh 1
		V1 =	regbank[2][121]*10000;	// vang 1
		GT1 =	regbank[2][122]*10000;	// giai toa 1
						
		X2 = regbank[2][123]*10000;		// xanh 2 
		V2 = regbank[2][124]*10000;	// vang 2
		GT2 = regbank[2][125]*10000;	// giai toa 2
						
//		X3 = regbank[2][200]*10000;	// xanh 3
//		V3 = regbank[2][201]*10000;	// vang 3
//		GT3 = regbank[2][202]*10000;	// giai toa 3
		
		begin_hour = regbank[2][126];
		begin_min = regbank[2][127];
		end_hour = regbank[2][140];
		end_min = regbank[2][141];
		
		D2 = GT2 + X1 + V1 + GT1;
		D1 = GT1 + X2 + V2 + GT2;
		
		// inform input_ok
		regbank[0][94] = 0;
		regbank[0][11] = 1;
		input_ok = 0;
	}
	
	//regbank[2][58] = getTime.Seconds;
	//regbank[2][59] = getTime.Seconds;
	//regbank[2][70] = getTime.Seconds;
	//regbank[2][71] = getTime.Seconds;
	//regbank[2][72] = getTime.Seconds;
	//regbank[2][73] = getTime.Seconds;
	//regbank[2][74] = getTime.Seconds;
	regbank[2][75] = getTime.Seconds;
	regbank[2][76] = getTime.Seconds;
	regbank[2][77] = getTime.Seconds;
	regbank[2][78] = getTime.Seconds;
	regbank[2][79] = getTime.Seconds;
	regbank[2][80] = getTime.Seconds;
	regbank[2][81] = getTime.Seconds;
	regbank[2][82] = getTime.Seconds;
	regbank[2][90] = getTime.Seconds;
	regbank[2][91] = getTime.Seconds;
//	regbank[2][120] = getTime.Seconds;
//	regbank[2][121] = getTime.Seconds;
//	regbank[2][122] = getTime.Seconds;
//	regbank[2][123] = getTime.Seconds;
//	regbank[2][124] = getTime.Seconds;
//	regbank[2][125] = getTime.Seconds;
//	regbank[2][126] = getTime.Seconds;
//	regbank[2][127] = getTime.Seconds;
//	regbank[2][140] = getTime.Seconds;
//	regbank[2][141] = getTime.Seconds;
	regbank[2][203] = getTime.Seconds;
	regbank[2][204] = getTime.Seconds;
	regbank[2][205] = getTime.Seconds;
	regbank[2][206] = getTime.Seconds;
	
	
	//if (regbank[0][94] == 1) regbank[0][94] = 0;
	if (regbank[0][95] == 1) regbank[0][95] = 0;
	//if (regbank[0][96] == 1) regbank[0][96] = 0;
	//if (regbank[0][97] == 1) regbank[0][97] = 0;
	if (regbank[0][98] == 1) regbank[0][98] = 0;
	//if (regbank[0][30] == 1) regbank[0][30] = 0;
	if (regbank[0][31] == 1) regbank[0][31] = 0;
	if (regbank[0][32] == 1) regbank[0][32] = 0;
    osDelay(1);
  }
  /* USER CODE END StartConnectivityTask */
}

/**
  * @brief  Period elapsed callback in non blocking mode
  * @note   This function is called  when TIM14 interrupt took place, inside
  * HAL_TIM_IRQHandler(). It makes a direct call to HAL_IncTick() to increment
  * a global variable "uwTick" used as application time base.
  * @param  htim : TIM handle
  * @retval None
  */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
  /* USER CODE BEGIN Callback 0 */

  /* USER CODE END Callback 0 */
  if (htim->Instance == TIM14)
  {
    HAL_IncTick();
  }
  /* USER CODE BEGIN Callback 1 */

  /* USER CODE END Callback 1 */
}

/**
  * @brief  This function is executed in case of error occurrence.
