  /*Configure GPIO pins : X3_Pin V3_Pin D3_Pin Xdb3_Pin
                           LED_3_Pin LED_2_Pin LED_1_Pin */
  GPIO_InitStruct.Pin = X3_Pin|V3_Pin|D3_Pin|Xdb3_Pin
